# Which AI service answers questions: anthropic (default), groq, gemini or openrouter.
NUXT_AI_PROVIDER=anthropic

# Set the key for the provider you chose; the others can stay empty.
NUXT_ANTHROPIC_API_KEY=
NUXT_GROQ_API_KEY=
NUXT_GEMINI_API_KEY=
NUXT_OPENROUTER_API_KEY=

# Optional: Pinecone retrieval. Leave the key empty to send the whole corpus instead.
NUXT_PINECONE_API_KEY=
NUXT_PINECONE_INDEX=portfolio
NUXT_PINECONE_NAMESPACE=corpus

# Optional tuning
# NUXT_ASK_MODEL=            # defaults: claude-opus-5-5 / llama-3.3-70b-versatile / gemini-2.5-flash / meta-llama/llama-3.3-70b-instruct:free
# NUXT_AI_BASE_URL=          # override the OpenAI-compatible endpoint for groq/gemini/openrouter
# NUXT_ASK_DAILY_LIMIT=1000
# NUXT_RETRIEVAL_TOP_K=6
